# Build output
build/
windows/build_tmp/
windows/dist/

# Bundled binaries — fetched on demand by build.sh
# (yt-dlp macOS standalone + arm64 ffmpeg/ffprobe from martin-riedl.de)
Sources/TapeNexus/Resources/bin/

# Local-only scratch / tooling state
.mockups/
.superpowers/
.claude/

# Cloud-sync credentials (Supabase publishable key). The committed sync.json
# is an empty template; put real values in sync.local.json (gitignored) and
# build.sh bakes it into the app. The publishable key is safe to ship (RLS is
# the real boundary) but kept out of the repo so it can rotate without a commit.
Sources/TapeNexus/Resources/sync.local.json
windows/tapenexus/sync.local.json

# macOS / editor noise
.DS_Store
*.swp

# Python bytecode (Windows port) — build artifacts, never commit
__pycache__/
*.pyc
# PyInstaller spec files (gallery-dl macOS build) — generated, never commit
*.spec